# RAKSHAK - Indian Public Assistance & Emergency Platform
# Environment Configuration Template

# Optional: Google Gemini API Key for AI Chatbot Assistance
# If not provided, RAKSHAK uses its built-in intelligent multi-lingual (English, Hindi, Hinglish) rule-based engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Authentication Secret (Used for staff portal session signing)
ADMIN_SECRET=rakshak_super_secret_admin_token_2026

# Application Environment
NODE_ENV=development

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
